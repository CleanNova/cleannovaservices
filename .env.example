# Where booking requests are delivered. Leave empty to use the WhatsApp/e-mail fallback.
#
# Option A — Formspree (https://formspree.io): paste your form endpoint
# VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
#
# Option B — Web3Forms (https://web3forms.com): endpoint + public access key
# VITE_FORM_ENDPOINT=https://api.web3forms.com/submit
# VITE_FORM_ACCESS_KEY=your-public-access-key
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=
